;; shadow-cljs configuration
{:source-paths
 ["src/main"]

 :dependencies
 [[reagent "1.3.0"]
  [arttuka/reagent-material-ui "5.11.12-0"]
  [re-frame "1.4.3"]
  [breaking-point "0.1.2"]
  [metosin/reitit "0.8.0"]]

 :builds
 {:app {:target :browser
        :output-dir "public/js"
        :asset-path "/js"
        :modules {:main {:init-fn app.core/main}}}
  :release {:target :browser
            :output-dir "public-release/js"
            :asset-path "/js"
            :modules {:main {:init-fn app.core/main}}}}
 :dev-http {8000 "public"}
 :nrepl {:port 3333}}
